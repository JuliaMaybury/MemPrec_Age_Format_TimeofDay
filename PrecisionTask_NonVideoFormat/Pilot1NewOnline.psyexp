      <CodeComponent name="code_Prac_test_2" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="degup1 = []&amp;#10;keys1 = []&amp;#10;posX1 = []&amp;#10;posY1 = []&amp;#10;pointposX1 = []&amp;#10;pointposY1 = []&amp;#10;&amp;#10;degup2 = []&amp;#10;keys2 = []&amp;#10;posX2 = []&amp;#10;posY2 = []&amp;#10;pointposX2 = []&amp;#10;pointposY2 = []&amp;#10;&amp;#10;degup3 = []&amp;#10;keys3 = []&amp;#10;posX3 = []&amp;#10;posY3 = []&amp;#10;pointposX3 = []&amp;#10;pointposY3 = []" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="degup1 = [];&amp;#10;keys1 = [];&amp;#10;posX1 = [];&amp;#10;posY1 = [];&amp;#10;pointposX1 = [];&amp;#10;pointposY1 = [];&amp;#10;degup2 = [];&amp;#10;keys2 = [];&amp;#10;posX2 = [];&amp;#10;posY2 = [];&amp;#10;pointposX2 = [];&amp;#10;pointposY2 = [];&amp;#10;degup3 = [];&amp;#10;keys3 = [];&amp;#10;posX3 = [];&amp;#10;posY3 = [];&amp;#10;pointposX3 = [];&amp;#10;pointposY3 = [];&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="psychoJS.eventManager.clearEvents()&amp;#10;keys1 = [];&amp;#10;if (OldImages == 0) {&amp;#10;    degup1 = ((-testNewLocStartVal)+90);&amp;#10;    pdeg1= (testNewLocStartVal);&amp;#10;} else if (OldImages == 1) {&amp;#10;    degup1 = ((-testObj1LocStartVal2) +90);&amp;#10;    pdeg1 = (testObj1LocStartVal2);&amp;#10;}&amp;#10;Eccentricity1 = (2.1277 * ((x_scale + y_scale) / 2));&amp;#10;Eccentricityobj1 = (4.3794 * ((x_scale + y_scale) / 2));&amp;#10;obj1posx1 = (Eccentricityobj1 * Math.cos(((pi / 180) * degup1)));&amp;#10;obj1posy1 = (Eccentricityobj1 * Math.sin(((pi / 180) * degup1)));&amp;#10;pointer1posX1 = (Eccentricity1 * Math.cos(((pi / 180) * degup1)));&amp;#10;pointer1posY1 = (Eccentricity1 * Math.sin(((pi / 180) * degup1)));&amp;#10;//Eccentricity2 = (2.1277 * ((x_scale + y_scale) / 2));&amp;#10;//Eccentricityobj2 = (4.3794 * ((x_scale + y_scale) / 2));&amp;#10;//if (Imm_Delay != 2){&amp;#10;//continueRoutine = true;&amp;#10;//}&amp;#10;//else if (Imm_Delay == 2){&amp;#10;   // continueRoutine = false:}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="keys1 = []&amp;#10;#keys1=event.getKeys()&amp;#10;#if new image use the newlocstart val&amp;#10;&amp;#10;if OldImages == 0:&amp;#10;    degup1 = ((-testNewLocStartVal)+90)&amp;#10;    pdeg1= (testNewLocStartVal)&amp;#10;elif OldImages == 1:&amp;#10;    degup1 = ((-testObj1LocStartVal2) +90)&amp;#10;    pdeg1 = (testObj1LocStartVal2)&amp;#10;&amp;#10;#degup1 = testObj1LocTargetVal&amp;#10;#pdeg1 = -testObj1LocTargetVal+90&amp;#10;&amp;#10;#Object1Test&amp;#10;Eccentricity1 = 2.1277*((x_scale+y_scale)/2)&amp;#10;Eccentricityobj1 = 4.3794*((x_scale+y_scale)/2)&amp;#10;&amp;#10;obj1posx1 = Eccentricityobj1 * cos((pi/180) *(degup1))&amp;#10;obj1posy1 = Eccentricityobj1 * sin((pi/180) *(degup1))&amp;#10;&amp;#10;pointer1posX1 = Eccentricity1 * cos((pi/180) *(degup1))&amp;#10;pointer1posY1 = Eccentricity1 * sin((pi/180) *(degup1))" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="keys1=event.getKeys()&amp;#10;&amp;#10;if len(keys1):&amp;#10;    if 'left' in keys1:&amp;#10;        degup1 = (degup1 + 2)&amp;#10;        posX1 = Eccentricityobj1 * cos((pi/180) *(degup1))&amp;#10;        posY1 = Eccentricityobj1 * sin((pi/180) *(degup1))&amp;#10;        obj1_ImmTest_Prac.setPos([posX1,posY1])&amp;#10;        pointposX1 =  Eccentricity1 * cos((pi/180) *(degup1))&amp;#10;        pointposY1 = Eccentricity1 * sin((pi/180) *(degup1))&amp;#10;        pointer1_Prac.setPos([pointposX1,pointposY1])&amp;#10;        pdeg1 = -degup1 +90&amp;#10;    #pointer1.setOri([pdeg1])&amp;#10;    elif 'right' in keys1:    &amp;#10;        degup1 = (degup1 - 2)&amp;#10;        posX1 = Eccentricityobj1 * cos((pi/180) *(degup1))&amp;#10;        posY1 = Eccentricityobj1 * sin((pi/180) *(degup1))&amp;#10;        obj1_ImmTest_Prac.setPos([posX1,posY1])&amp;#10;        pointposX1 =  Eccentricity1 * cos((pi/180) *(degup1))&amp;#10;        pointposY1 = Eccentricity1 * sin((pi/180) *(degup1))&amp;#10;        pointer1_Prac.setPos([pointposX1,pointposY1])&amp;#10;        pdeg1 = -degup1+90&amp;#10;    #pointer1.setOri([pdeg1])&amp;#10;#if Imm_Delay != 2:&amp;#10;    #continueRoutine = True&amp;#10;#else:&amp;#10;     #continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="var _pj;&amp;#10;function _pj_snippets(container) {&amp;#10;    function in_es6(left, right) {&amp;#10;        if (((right instanceof Array) || ((typeof right) === &quot;string&quot;))) {&amp;#10;            return (right.indexOf(left) &gt; (- 1));&amp;#10;        } else {&amp;#10;            if (((right instanceof Map) || (right instanceof Set) || (right instanceof WeakMap) || (right instanceof WeakSet))) {&amp;#10;                return right.has(left);&amp;#10;            } else {&amp;#10;                return (left in right);&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;    container[&quot;in_es6&quot;] = in_es6;&amp;#10;    return container;&amp;#10;}&amp;#10;_pj = {};&amp;#10;_pj_snippets(_pj);&amp;#10;keys1 = psychoJS.eventManager.getKeys();&amp;#10;if (keys1.length) {&amp;#10;    if (_pj.in_es6(&quot;left&quot;, keys1)) {&amp;#10;        degup1 = (degup1 + 2);&amp;#10;        posX1 = (Eccentricityobj1 * Math.cos(((pi / 180) * degup1)));&amp;#10;        posY1 = (Eccentricityobj1 * Math.sin(((pi / 180) * degup1)));&amp;#10;        obj1_ImmTest_Prac.setPos([posX1, posY1]);&amp;#10;        pointposX1 = (Eccentricity1 * Math.cos(((pi / 180) * degup1)));&amp;#10;        pointposY1 = (Eccentricity1 * Math.sin(((pi / 180) * degup1)));&amp;#10;        pointer1_Prac.setPos([pointposX1, pointposY1]);&amp;#10;        pdeg1 = ((-degup1) + 90);&amp;#10;    } else {&amp;#10;        if (_pj.in_es6(&quot;right&quot;, keys1)) {&amp;#10;            degup1 = (degup1 - 2);&amp;#10;            posX1 = (Eccentricityobj1 * Math.cos(((pi / 180) * degup1)));&amp;#10;            posY1 = (Eccentricityobj1 * Math.sin(((pi / 180) * degup1)));&amp;#10;            obj1_ImmTest_Prac.setPos([posX1, posY1]);&amp;#10;            pointposX1 = (Eccentricity1 * Math.cos(((pi / 180) * degup1)));&amp;#10;            pointposY1 = (Eccentricity1 * Math.sin(((pi / 180) * degup1)));&amp;#10;            pointer1_Prac.setPos([pointposX1, pointposY1]);&amp;#10;            pdeg1 = ((-degup1) + 90);&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="&amp;#10;//pdeg2_adj = (((pdeg1 * (- 1)) + 90) % 360);&amp;#10;pdeg2_adj = ((((pdeg1)%360) + 360)%360);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="#for i in range(len(pdeg1)):&amp;#10; #   pdeg1_neg[i] = -pdeg1[i]&amp;#10;&amp;#10;pdeg2_adj = (((pdeg1*-1) + 90) % 360);&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>

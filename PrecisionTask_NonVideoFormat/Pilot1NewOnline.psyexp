        <Param val="FCim = [];&amp;#10;degup1 = [];&amp;#10;keys1 = [];&amp;#10;posX1 = [];&amp;#10;posY1 = [];&amp;#10;pointposX1 = [];&amp;#10;pointposY1 = [];&amp;#10;degup2 = [];&amp;#10;keys2 = [];&amp;#10;posX2 = [];&amp;#10;posY2 = [];&amp;#10;pointposX2 = [];&amp;#10;pointposY2 = [];&amp;#10;degup3 = [];&amp;#10;keys3 = [];&amp;#10;posX3 = [];&amp;#10;posY3 = [];&amp;#10;pointposX3 = [];&amp;#10;pointposY3 = [];&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="FCleft1 = null;&amp;#10;FCdisp1 = null;&amp;#10;myReps = 1;&amp;#10;Fix=0;&amp;#10;&amp;#10;if (OldImages === 1 &amp;&amp; Imm_Delay === 1) {&amp;#10;    FCleft1 = testObj1Target;&amp;#10;    FCdisp1 = 'resources/' + testObj1Target.split('.')[0] + '.png';&amp;#10;} else if (OldImages === 0 &amp;&amp; Imm_Delay === 1) {&amp;#10;    FCleft1 = NewObject;&amp;#10;    FCdisp1 = 'resources/' + NewObject.split('.')[0] + '.png';&amp;#10;}&amp;#10;&amp;#10;if (Imm_Delay !== 2) {&amp;#10;    FCim = 'resources/' + FCleft1;&amp;#10;} else if (Imm_Delay === 2) {&amp;#10;    myReps = 0;&amp;#10;    continueRoutine = false;&amp;#10;}" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="FCleft1 = None&amp;#10;FCdisp1 = None&amp;#10;myReps = 1&amp;#10;Fix=0&amp;#10;&amp;#10;if OldImages == 1 and Imm_Delay == 1:&amp;#10;    FCleft1 = testObj1Target&amp;#10;    FCdisp1 = 'resources/' + testObj1Target.rsplit('.', 1)[0] + '.png'&amp;#10;elif OldImages == 0 and Imm_Delay == 1:&amp;#10;    FCleft1 = NewObject&amp;#10;    FCdisp1 = 'resources/' + NewObject.rsplit('.', 1)[0] + '.png'&amp;#10;&amp;#10;&amp;#10;if Imm_Delay != 2:&amp;#10;    FCim = 'resources/' + FCleft1&amp;#10;elif Imm_Delay == 2:&amp;#10;     myReps = 0&amp;#10;     continueRoutine = False" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if ((FCKey2.keys !== undefined) &amp;&amp; (FCKey2.keys == '1')) {&amp;#10;    continueRoutine = true;&amp;#10;}&amp;#10;if (Imm_Delay!==2) {&amp;#10;    continueRoutine=true;&amp;#10;} else if (Imm_Delay==2) {&amp;#10;    myReps=0;&amp;#10;    continueRoutine=false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="Fix=0;&amp;#10;myReps=1;&amp;#10;&amp;#10;if ((FCKey2.keys !== undefined) &amp;&amp; (FCKey2.keys == '1')) {&amp;#10;    Fix=0;&amp;#10;    continueRoutine = true;&amp;#10;} else if (FCKey2.keys =='2') {&amp;#10;    myReps=0;&amp;#10;    Fix=1;&amp;#10;    continueRoutine = false;&amp;#10;}" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# Check for keyboard presses&amp;#10;#if '3' in FCKey2.keys or '4' in FCKey2.keys:&amp;#10;    #continueRoutine = False  # Do not continue this routine&amp;#10;Fix=0&amp;#10;&amp;#10;if FCKey2.keys=='1':&amp;#10;    Fix=0&amp;#10;    continueRoutine = True&amp;#10;    &amp;#10;elif FCKey2.keys=='2':&amp;#10;    Fix=1&amp;#10;    myReps=0&amp;#10;    continueRoutine = False&amp;#10;&amp;#10;if 'left' in FCKey2.keys:&amp;#10;    FCim = FCims[0]" valType="extendedCode" updates="constant" name="End Routine"/>

        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# Initialize variables at the start of the experiment&amp;#10;Attention = 0  # Start with Attention set to 0 (not running)&amp;#10;attention1_shown = False  # Flag to track if Attention2_question has been shown&amp;#10;# Assuming these variables are initialized elsewhere in your code&amp;#10;consecutive_new_count_block1 = 0  # Count of consecutive &quot;new&quot; clicks (key '2')&amp;#10;consecutive_old_count_block1  = 0  # Count of consecutive &quot;old&quot; clicks (key '1')&amp;#10;newthreshold = 4  # Set a threshold for consecutive clicks (adjust as needed)&amp;#10;oldthreshold = 6" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="Attention = 0;&amp;#10;attention1_shown = false;&amp;#10;consecutive_new_count_block1 = 0;&amp;#10;consecutive_old_count_block1 = 0;&amp;#10;newthreshold = 4;&amp;#10;oldthreshold = 6;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((FCKey2.keys === &quot;2&quot;)) {&amp;#10;    consecutive_new_count_block1 += 1;&amp;#10;    consecutive_old_count_block1 = 0;&amp;#10;} else {&amp;#10;    if ((FCKey2.keys === &quot;1&quot;)) {&amp;#10;        consecutive_old_count_block1 += 1;&amp;#10;        consecutive_new_count_block1 = 0;&amp;#10;    } else {&amp;#10;        consecutive_new_count_block1 = 0;&amp;#10;        consecutive_old_count_block1 = 0;&amp;#10;    }&amp;#10;}&amp;#10;if (((((((ImmediateTest_1.thisN &gt;= 14) &amp;&amp; (FCKey2.keys === &quot;2&quot;)) &amp;&amp; (! attention1_shown)) || ((ImmediateTest_1.thisN === 28) &amp;&amp; (! attention1_shown))) || ((consecutive_new_count_block1 &gt; newthreshold) &amp;&amp; (! attention1_shown))) || ((consecutive_old_count_block1 &gt; oldthreshold) &amp;&amp; (! attention1_shown)))) {&amp;#10;    Attention = 1;&amp;#10;    Fix = 1;&amp;#10;    attention1_shown = true;&amp;#10;} else {&amp;#10;    Attention = 0;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Check if the participant pressed 'new' (2) and it's the 4th trial or later&amp;#10;#if Prac_Test.thisN &gt;= 4 and FCKey2_3.keys == '2' and not attention2_shown:&amp;#10;#    Attention = 1  # Set Attention to 1 to run Attention2_question&amp;#10;#    attention2_shown = True  # Mark that Attention2_question has been shown&amp;#10;#else:&amp;#10;#    Attention = 0  # Do not run Attention2_question&amp;#10;&amp;#10;# Update counts based on user input&amp;#10;if FCKey2.keys == '2':  # If &quot;new&quot; is pressed&amp;#10;    consecutive_new_count_block1  += 1&amp;#10;    consecutive_old_count_block1  = 0  # Reset the old count&amp;#10;elif FCKey2.keys == '1':  # If &quot;old&quot; is pressed&amp;#10;    consecutive_old_count_block1  += 1&amp;#10;    consecutive_new_count_block1  = 0  # Reset the new count&amp;#10;else:&amp;#10;    consecutive_new_count_block1  = 0  # Reset both if any other key is pressed&amp;#10;    consecutive_old_count_block1  = 0&amp;#10;&amp;#10;# Check conditions to decide whether to show the attention question&amp;#10;if (ImmediateTest_1.thisN &gt;= 14 and FCKey2.keys == '2' and not attention1_shown) or \&amp;#10;   (ImmediateTest_1.thisN == 28 and not attention1_shown) or \&amp;#10;   (consecutive_new_count_block1  &gt; newthreshold and not attention1_shown) or \&amp;#10;   (consecutive_old_count_block1  &gt; oldthreshold and not attention1_shown):&amp;#10;    Attention = 1  # Set Attention to 1 to run Attention2_question&amp;#10;    Fix=1&amp;#10;    attention1_shown = True  # Mark that Attention2_question has been shown&amp;#10;else:&amp;#10;    Attention = 0  # Do not run Attention2_question&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>

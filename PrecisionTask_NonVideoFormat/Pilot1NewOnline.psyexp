      <CodeComponent name="FC_code_3" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="FCim = []&amp;#10;degup1 = []&amp;#10;keys1 = []&amp;#10;posX1 = []&amp;#10;posY1 = []&amp;#10;pointposX1 = []&amp;#10;pointposY1 = []&amp;#10;&amp;#10;degup2 = []&amp;#10;keys2 = []&amp;#10;posX2 = []&amp;#10;posY2 = []&amp;#10;pointposX2 = []&amp;#10;pointposY2 = []&amp;#10;&amp;#10;degup3 = []&amp;#10;keys3 = []&amp;#10;posX3 = []&amp;#10;posY3 = []&amp;#10;pointposX3 = []&amp;#10;pointposY3 = []  " valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="FCim = [];&amp;#10;degup1 = [];&amp;#10;keys1 = [];&amp;#10;posX1 = [];&amp;#10;posY1 = [];&amp;#10;pointposX1 = [];&amp;#10;pointposY1 = [];&amp;#10;degup2 = [];&amp;#10;keys2 = [];&amp;#10;posX2 = [];&amp;#10;posY2 = [];&amp;#10;pointposX2 = [];&amp;#10;pointposY2 = [];&amp;#10;degup3 = [];&amp;#10;keys3 = [];&amp;#10;posX3 = [];&amp;#10;posY3 = [];&amp;#10;pointposX3 = [];&amp;#10;pointposY3 = [];&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="FCleft1 = null;&amp;#10;FCdisp1 = null;&amp;#10;&amp;#10;// Check if both cuevalidity and cueprobe conditions are met&amp;#10;if (CueValidity === 1 &amp;&amp; CueProbe === 1) {&amp;#10;    FCleft1 = testObj1Target;&amp;#10;    FCdisp1 = 'resources/' + testObj1Target.split('.')[0] + '.png';&amp;#10;} else if (CueValidity === 0 &amp;&amp; CueProbe === 0) {&amp;#10;    FCleft1 = testObj2Target;&amp;#10;    FCdisp1 = 'resources/' + testObj2Target.split('.')[0] + '.png';&amp;#10;} else if (CueValidity === 0 &amp;&amp; CueProbe === 1) {&amp;#10;    FCleft1 = testObj1Target;&amp;#10;    FCdisp1 = 'resources/' + testObj1Target.split('.')[0] + '.png';&amp;#10;} else if (CueValidity === 0.5 &amp;&amp; CueProbe === 0.5) {&amp;#10;    FCleft1 = testObj3Target;&amp;#10;    FCdisp1 = 'resources/' + testObj3Target.split('.')[0] + '.png';&amp;#10;}&amp;#10;&amp;#10;// Check if objectimages column has a value of 0&amp;#10;if (OldImages === 0 ){&amp;#10;    FCleft1 = NewObject;&amp;#10;    FCdisp1 = 'resources/' + NewObject.split('.')[0] + '.png';&amp;#10;}&amp;#10;else if (OldImages ==1){&amp;#10;    FCleft1 = testObj1Target;&amp;#10;    FCdisp1 = 'resources/' + testObj1Target.split('.')[0] + '.png';&amp;#10;  }&amp;#10;&amp;#10;FCim = 'resources/' + FCleft1;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="FCleft1 = None&amp;#10;FCdisp1 = None&amp;#10;&amp;#10;if OldImages == 1:&amp;#10;    FCleft1 = testObj1Target&amp;#10;    FCdisp1 = 'resources/' + testObj1Target.rsplit('.', 1)[0] + '.png'&amp;#10;elif OldImages == 0:&amp;#10;    FCleft1 = NewObject&amp;#10;    FCdisp1 = 'resources/' + NewObject.rsplit('.', 1)[0] + '.png'&amp;#10;&amp;#10;FCim = 'resources/' + FCleft1" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>

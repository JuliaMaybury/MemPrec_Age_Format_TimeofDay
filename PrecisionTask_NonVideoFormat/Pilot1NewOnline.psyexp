      <CodeComponent name="Prac_Learn_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="degup1 = []&amp;#10;keys1 = []&amp;#10;posX1 = []&amp;#10;posY1 = []&amp;#10;pointposX1 = []&amp;#10;pointposY1 = []&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="degup1 = [];&amp;#10;keys1 = [];&amp;#10;posX1 = [];&amp;#10;posY1 = [];&amp;#10;pointposX1 = [];&amp;#10;pointposY1 = [];&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="Eccentricity1 = (2.1277 * ((x_scale + y_scale) / 2));&amp;#10;Eccentricityobj1 = (4.3794 * ((x_scale + y_scale) / 2));&amp;#10;keys1 = [];&amp;#10;degup1 = ((-testObj1LocStartVal1)+90);&amp;#10;pdeg1 = (testObj1LocStartVal1);&amp;#10;obj1posx1 = (Eccentricityobj1 * Math.cos(((Math.PI / 180) * degup1)));&amp;#10;obj1posy1 = (Eccentricityobj1 * Math.sin(((Math.PI / 180) * degup1)));&amp;#10;pointer1posX1 = (Eccentricity1 * Math.cos(((Math.PI / 180) * degup1)));&amp;#10;pointer1posY1 = (Eccentricity1 * Math.sin(((Math.PI / 180) * degup1)));&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="#Object1Test&amp;#10;Eccentricity1 = 2.1277*((x_scale+y_scale)/2)&amp;#10;Eccentricityobj1 = 4.3794*((x_scale+y_scale)/2)&amp;#10;&amp;#10;keys1 = []&amp;#10;&amp;#10;#degup1 = testObj1LocTargetVal&amp;#10;#pdeg1 = -testObj1LocTargetVal+90&amp;#10;&amp;#10;degup1 = ((-testObj1LocStartVal1)+90)&amp;#10;pdeg1 = (testObj1LocStartVal1)&amp;#10;&amp;#10;obj1posx1 = Eccentricityobj1 * cos((pi/180) *(degup1))&amp;#10;obj1posy1 = Eccentricityobj1 * sin((pi/180) *(degup1))&amp;#10;&amp;#10;pointer1posX1 = Eccentricity1 * cos((pi/180) *(degup1))&amp;#10;pointer1posY1 = Eccentricity1 * sin((pi/180) *(degup1))&amp;#10;&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="keys1=event.getKeys()&amp;#10;&amp;#10;if len(keys1):&amp;#10;    if 'left' in keys1:&amp;#10;        degup1 = (degup1 + 2)&amp;#10;        posX1 = Eccentricityobj1 * cos((pi/180) *(degup1))&amp;#10;        posY1 = Eccentricityobj1 * sin((pi/180) *(degup1))&amp;#10;        obj1_WMTest_Prac.setPos([posX1,posY1])&amp;#10;        pointposX1 =  Eccentricity1 * cos((pi/180) *(degup1))&amp;#10;        pointposY1 = Eccentricity1 * sin((pi/180) *(degup1))&amp;#10;        pointer1_WMTest_Prac.setPos([pointposX1,pointposY1])&amp;#10;        pdeg1 = -degup1+90&amp;#10;    #pointer1.setOri([pdeg1])&amp;#10;    elif 'right' in keys1:    &amp;#10;        degup1 = (degup1 - 2)&amp;#10;        posX1 = Eccentricityobj1 * cos((pi/180) *(degup1))&amp;#10;        posY1 = Eccentricityobj1 * sin((pi/180) *(degup1))&amp;#10;        obj1_WMTest_Prac.setPos([posX1,posY1])&amp;#10;        pointposX1 =  Eccentricity1 * cos((pi/180) *(degup1))&amp;#10;        pointposY1 = Eccentricity1 * sin((pi/180) *(degup1))&amp;#10;        pointer1_WMTest_Prac.setPos([pointposX1,pointposY1])&amp;#10;        pdeg1 = -degup1+90&amp;#10;    #pointer1.setOri([pdeg1])&amp;#10;    " valType="extendedCode" updates="constant" name="Each Frame"/>

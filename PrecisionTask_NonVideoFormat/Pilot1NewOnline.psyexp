      <CodeComponent name="Trial_Tracker_2" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# Initialize variables at the start of the experiment&amp;#10;Attention = 0  # Start with Attention set to 0 (not running)&amp;#10;attentionprac_shown = False  # Flag to track if Attention2_question has been shown&amp;#10;# Assuming these variables are initialized elsewhere in your code&amp;#10;consecutive_new_count_prac = 0  # Count of consecutive &quot;new&quot; clicks (key '2')&amp;#10;consecutive_old_count_prac = 0  # Count of consecutive &quot;old&quot; clicks (key '1')&amp;#10;newthreshold = 2  # Set a threshold for consecutive clicks (adjust as needed)&amp;#10;oldthreshold = 2" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="Attention = 0;&amp;#10;attentionprac_shown = false;&amp;#10;consecutive_new_count_prac = 0;&amp;#10;consecutive_old_count_prac = 0;&amp;#10;newthreshold = 2;&amp;#10;oldthreshold = 2;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((FCKey2_3.keys === &quot;2&quot;)) {&amp;#10;    consecutive_new_count_prac += 1;&amp;#10;    consecutive_old_count_prac = 0;&amp;#10;} else {&amp;#10;    if ((FCKey2_3.keys === &quot;1&quot;)) {&amp;#10;        consecutive_old_count_prac += 1;&amp;#10;        consecutive_new_count_prac = 0;&amp;#10;    } else {&amp;#10;        consecutive_new_count_prac = 0;&amp;#10;        consecutive_old_count_prac = 0;&amp;#10;    }&amp;#10;}&amp;#10;if ((((((Prac_Test.thisN &gt;= 5) &amp;&amp; (FCKey2.keys === &quot;2&quot;)) &amp;&amp; (! attentionprac_shown)) || ((consecutive_new_count_prac &gt; newthreshold) &amp;&amp; (! attentionprac_shown))) || ((consecutive_old_count_prac &gt; oldthreshold) &amp;&amp; (! attentionprac_shown)))) {&amp;#10;    Attention = 1;&amp;#10;    fix = 1;&amp;#10;    attentionprac_shown = true;&amp;#10;} else {&amp;#10;    Attention = 0;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Check if the participant pressed 'new' (2) and it's the 4th trial or later&amp;#10;#if Prac_Test.thisN &gt;= 4 and FCKey2_3.keys == '2' and not attention2_shown:&amp;#10;#    Attention = 1  # Set Attention to 1 to run Attention2_question&amp;#10;#    attention2_shown = True  # Mark that Attention2_question has been shown&amp;#10;#else:&amp;#10;#    Attention = 0  # Do not run Attention2_question&amp;#10;&amp;#10;# Update counts based on user input&amp;#10;if FCKey2_3.keys == '2':  # If &quot;new&quot; is pressed&amp;#10;    consecutive_new_count_prac += 1&amp;#10;    consecutive_old_count_prac = 0  # Reset the old count&amp;#10;elif FCKey2_3.keys == '1':  # If &quot;old&quot; is pressed&amp;#10;    consecutive_old_count_prac += 1&amp;#10;    consecutive_new_count_prac = 0  # Reset the new count&amp;#10;else:&amp;#10;    consecutive_new_count_prac = 0  # Reset both if any other key is pressed&amp;#10;    consecutive_old_count_prac = 0&amp;#10;&amp;#10;# Check conditions to decide whether to show the attention question&amp;#10;if (Prac_Test.thisN &gt;= 5 and FCKey2.keys == '2' and not attentionprac_shown) or \&amp;#10;   (consecutive_new_count_prac &gt; newthreshold and not attentionprac_shown) or \&amp;#10;   (consecutive_old_count_prac &gt; oldthreshold and not attentionprac_shown):&amp;#10;    Attention = 1  # Set Attention to 1 to run Attention2_question&amp;#10;    fix = 1&amp;#10;    attentionprac_shown = True  # Mark that Attention2_question has been shown&amp;#10;else:&amp;#10;    Attention = 0  # Do not run Attention2_question&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="psychoJS.experiment.addData(&quot;consecutive_new_count_prac&quot;, consecutive_new_count_prac);&amp;#10;psychoJS.experiment.addData(&quot;consecutive_old_count_prac&quot;, consecutive_old_count_prac);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="thisExp.addData('consecutive_new_count_prac', consecutive_new_count_prac)&amp;#10;thisExp.addData('consecutive_old_count_prac', consecutive_old_count_prac)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>

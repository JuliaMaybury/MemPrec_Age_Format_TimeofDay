        <Param val="FCleft1 = null;&amp;#10;FCdisp1 = null;&amp;#10;&amp;#10;if (OldImages === 1) {&amp;#10;    FCleft1 = testObj1Target;&amp;#10;    FCdisp1 = &quot;resources/&quot; + testObj1Target.split(&quot;.&quot;).slice(0, -1).join(&quot;.&quot;) + &quot;.png&quot;;&amp;#10;} else if (OldImages === 0) {&amp;#10;    FCleft1 = NewObject;&amp;#10;    FCdisp1 = &quot;resources/&quot; + NewObject.split(&quot;.&quot;).slice(0, -1).join(&quot;.&quot;) + &quot;.png&quot;;&amp;#10;}&amp;#10;&amp;#10;FCim = &quot;resources/&quot; + FCleft" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="import random&amp;#10;&amp;#10;# Initialize variables at the beginning of the routine&amp;#10;FCleft1 = None&amp;#10;FCdisp1 = None&amp;#10;&amp;#10;# Assuming these variables are initialized somewhere&amp;#10;old_presentations = 0&amp;#10;new_presentations = 0&amp;#10;max_consecutive_old_presentations = 3&amp;#10;max_consecutive_new_presentations = 3&amp;#10;&amp;#10;# Check if there are any skipped trials to handle first&amp;#10;if skipped_trials:&amp;#10;    # Get the first skipped trial&amp;#10;    skipped_trial = skipped_trials.pop(0)  # Remove and get the first skipped trial&amp;#10;    Prac_Test.thisTrialN = skipped_trial  # Set to the skipped trial number&amp;#10;&amp;#10;    # Logic to determine if it is old or new and set FCleft1 and FCdisp1 accordingly&amp;#10;    if OldImages == 1:&amp;#10;        FCleft1 = testObj1Target&amp;#10;        FCdisp1 = 'resources/' + testObj1Target.rsplit('.', 1)[0] + '.png'&amp;#10;        old_presentations += 1  # Increment old counter for skipped trial&amp;#10;        new_presentations = 0    # Reset consecutive new counter&amp;#10;    else:&amp;#10;        FCleft1 = NewObject&amp;#10;        FCdisp1 = 'resources/' + NewObject.rsplit('.', 1)[0] + '.png'&amp;#10;        new_presentations += 1  # Increment new counter for skipped trial&amp;#10;        old_presentations = 0    # Reset consecutive old counter&amp;#10;&amp;#10;    # If we display a skipped trial, continue the routine&amp;#10;    continueRoutine = True&amp;#10;&amp;#10;else:&amp;#10;    # Normal trial handling logic for old images&amp;#10;    if OldImages == 1 and old_presentations &lt; max_consecutive_old_presentations:&amp;#10;        FCleft1 = testObj1Target&amp;#10;        FCdisp1 = 'resources/' + testObj1Target.rsplit('.', 1)[0] + '.png'&amp;#10;        old_presentations += 1  # Increment consecutive old counter&amp;#10;        new_presentations = 0    # Reset consecutive new counter&amp;#10;    else:&amp;#10;        # Too many old images in a row, skip and add to skipped trials&amp;#10;        skipped_trial = Prac_Test.thisTrialN  # Get current trial info&amp;#10;        skipped_trials.append(skipped_trial)  # Store skipped trial&amp;#10;        &amp;#10;        # Ensure there's room to insert&amp;#10;        if Prac_Test.thisTrialN &lt; Prac_Test.nTotal - 1:  &amp;#10;            insert_pos = random.randint(int(Prac_Test.thisTrialN) + 1, int(Prac_Test.nTotal) - 1)&amp;#10;            skipped_trials.insert(insert_pos, skipped_trial)  # Insert at a random position&amp;#10;        continueRoutine = False  # Skip this trial&amp;#10;&amp;#10;    # Normal trial handling logic for new images&amp;#10;    if OldImages == 0 and new_presentations &lt; max_consecutive_new_presentations:&amp;#10;        FCleft1 = NewObject&amp;#10;        FCdisp1 = 'resources/' + NewObject.rsplit('.', 1)[0] + '.png'&amp;#10;        new_presentations += 1  # Increment consecutive new counter&amp;#10;        old_presentations = 0    # Reset consecutive old counter&amp;#10;    else:&amp;#10;        # Too many new images in a row, skip and add to skipped trials&amp;#10;        skipped_trial = Prac_Test.thisTrialN  # Get current trial info&amp;#10;        skipped_trials.append(skipped_trial)  # Store skipped trial&amp;#10;        &amp;#10;        # Ensure there's room to insert&amp;#10;        if Prac_Test.thisTrialN &lt; Prac_Test.nTotal - 1:  &amp;#10;            insert_pos = random.randint(int(Prac_Test.thisTrialN) + 1, int(Prac_Test.nTotal) - 1)&amp;#10;            skipped_trials.insert(insert_pos, skipped_trial)  # Insert at a random position&amp;#10;        continueRoutine = False  # Skip this trial&amp;#10;&amp;#10;# If we get here, we can set FCim to display the image&amp;#10;if FCleft1 is not None:&amp;#10;    FCim = 'resources/' + FCleft1&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>

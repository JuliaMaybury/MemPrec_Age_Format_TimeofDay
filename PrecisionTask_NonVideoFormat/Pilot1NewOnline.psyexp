        <Param val="psychoJS.experiment.addData(&quot;consecutive_new_count_block3&quot;, consecutive_new_count_block3);&amp;#10;psychoJS.experiment.addData(&quot;consecutive_old_count_block3&quot;, consecutive_old_count_block3);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>

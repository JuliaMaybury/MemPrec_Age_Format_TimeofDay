        <Param val="# Initialize counters and skipped trials list&amp;#10;skipped_trials = []  # List to store skipped trials&amp;#10;old_count = 0  # Total count of old images shown&amp;#10;new_count = 0  # Total count of new images shown&amp;#10;consecutive_old = 0  # Tracks consecutive old images&amp;#10;consecutive_new = 0  # Tracks consecutive new images&amp;#10;max_consecutive = 2  # Max consecutive old/new images allowed&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>

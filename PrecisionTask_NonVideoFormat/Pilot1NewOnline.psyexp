        <Param val="thisExp.addData('consecutive_new_count_block1 ', consecutive_new_count_block1 )&amp;#10;thisExp.addData('consecutive_old_count_block1 ', consecutive_old_count_block1 )" valType="extendedCode" updates="constant" name="End Routine"/>

      <CodeComponent name="LTM_Prac_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="#FCims1 = []&amp;#10;#FCims2 = []&amp;#10;#FCims3 = []&amp;#10;&amp;#10;degup1 = []&amp;#10;keys1 = []&amp;#10;posX1 = []&amp;#10;posY1 = []&amp;#10;pointposX1 = []&amp;#10;pointposY1 = []&amp;#10;&amp;#10;degup2 = []&amp;#10;keys2 = []&amp;#10;posX2 = []&amp;#10;posY2 = []&amp;#10;pointposX2 = []&amp;#10;pointposY2 = []&amp;#10;&amp;#10;degup3 = []&amp;#10;keys3 = []&amp;#10;posX3 = []&amp;#10;posY3 = []&amp;#10;pointposX3 = []&amp;#10;pointposY3 = []" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="degup1 = [];&amp;#10;keys1 = [];&amp;#10;posX1 = [];&amp;#10;posY1 = [];&amp;#10;pointposX1 = [];&amp;#10;pointposY1 = [];&amp;#10;degup2 = [];&amp;#10;keys2 = [];&amp;#10;posX2 = [];&amp;#10;posY2 = [];&amp;#10;pointposX2 = [];&amp;#10;pointposY2 = [];&amp;#10;degup3 = [];&amp;#10;keys3 = [];&amp;#10;posX3 = [];&amp;#10;posY3 = [];&amp;#10;pointposX3 = [];&amp;#10;pointposY3 = [];&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="Eccentricity2 = (2.1277 * ((x_scale + y_scale) / 2));&amp;#10;Eccentricityobj2 = (4.3794 * ((x_scale + y_scale) / 2));&amp;#10;keys1 = [];&amp;#10;degup2 = testObj2LocStartVal;&amp;#10;pdeg2 = ((testObj2LocStartVal) + 90);&amp;#10;obj1posx2 = (Eccentricityobj2 * Math.cos(((Math.PI / 180) * degup2)));&amp;#10;obj1posy2 = (Eccentricityobj2 * Math.sin(((Math.PI / 180) * degup2)));&amp;#10;pointer1posX2 = (Eccentricity2 * Math.cos(((Math.PI / 180) * degup2)));&amp;#10;pointer1posY2 = (Eccentricity2 * Math.sin(((Math.PI / 180) * degup2)));&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="Eccentricity2 = 2.1277 * ((x_scale + y_scale) / 2)&amp;#10;Eccentricityobj2 = 4.3794 * ((x_scale + y_scale) / 2)&amp;#10;&amp;#10;keys1 = []&amp;#10;&amp;#10;degup2 = testObj2LocStartVal&amp;#10;pdeg2 = -testObj2LocStartVal + 90&amp;#10;&amp;#10;obj1posx2 = Eccentricityobj2 * cos((pi / 180) * (degup2))&amp;#10;obj1posy2 = Eccentricityobj2 * sin((pi / 180) * (degup2))&amp;#10;&amp;#10;pointer1posX2 = Eccentricity2 * cos((pi / 180) * (degup2))&amp;#10;pointer1posY2 = Eccentricity2 * sin((pi / 180) * (degup2))&amp;#10; " valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="if '3' in FCKey1_Prac.keys or '4' in FCKey1_Prac.keys:&amp;#10;    continueRoutine = False  # Do not continue this routine&amp;#10;elif '1' in FCKey1_Prac.keys or '2' in FCKey1_Prac.keys:&amp;#10;    continueRoutine = True  # Restart the loop (Go back to the next FC_1 routine)&amp;#10;&amp;#10;keys1=event.getKeys()&amp;#10;&amp;#10;if len(keys1):&amp;#10;    if 'left' in keys1:&amp;#10;        degup2 = (degup2 + 2)&amp;#10;        posX2 = Eccentricityobj2 * cos((pi/180) *(degup2))&amp;#10;        posY2 = Eccentricityobj2 * sin((pi/180) *(degup2))&amp;#10;        Obj1LTM_prac.setPos([posX2,posY2])&amp;#10;        pointposX2 =  Eccentricity2 * cos((pi/180) *(degup2))&amp;#10;        pointposY2 = Eccentricity2 * sin((pi/180) *(degup2))&amp;#10;        PointerLTM1_prac.setPos([pointposX2,pointposY2])&amp;#10;        pdeg2 = -degup2+90&amp;#10;    #pointer1.setOri([pdeg1])&amp;#10;    elif 'right' in keys1:    &amp;#10;        degup2 = (degup2 - 2)&amp;#10;        posX2 = Eccentricityobj2 * cos((pi/180) *(degup2))&amp;#10;        posY2 = Eccentricityobj2 * sin((pi/180) *(degup2))&amp;#10;        Obj1LTM_prac.setPos([posX2,posY2])&amp;#10;        pointposX2 =  Eccentricity2 * cos((pi/180) *(degup2))&amp;#10;        pointposY2 = Eccentricity2 * sin((pi/180) *(degup2))&amp;#10;        PointerLTM1_prac.setPos([pointposX2,pointposY2])&amp;#10;        pdeg2 = -degup2+90&amp;#10;    #pointer1.setOri([pdeg1])&amp;#10;#keys1=event.getKeys()&amp;#10;&amp;#10;#if len(keys):&amp;#10;#    if 'left' in keys:&amp;#10;#        degup2 = (degup2 + 2)&amp;#10;#        posX2 = Eccentricityobj2 * cos((pi / 180) * (degup2))&amp;#10;#        posY2 = Eccentricityobj2 * sin((pi / 180) * (degup2))&amp;#10;#        Obj2LTM.setPos([posX2, posY2])&amp;#10;#        pointposX2 = Eccentricity2 * cos((pi / 180) * (degup2))&amp;#10;#        pointposY2 = Eccentricity2 * sin((pi / 180) * (degup2))&amp;#10;#        PointerLTM2.setPos([pointposX2, pointposY2])&amp;#10;#        pdeg2 = -degup2 + 90&amp;#10;&amp;#10;#    elif 'right' in keys:    &amp;#10;#        degup2 = (degup2 - 2)&amp;#10;#        posX2 = Eccentricityobj2 * cos((pi / 180) * (degup2))&amp;#10;#        posY2 = Eccentricityobj2 * sin((pi / 180) * (degup2))&amp;#10;#        Obj2LTM.setPos([posX2, posY2])&amp;#10;#        pointposX2 = Eccentricity2 * cos((pi / 180) * (degup2))&amp;#10;#        pointposY2 = Eccentricity2 * sin((pi / 180) * (degup2))&amp;#10;#        PointerLTM2.setPos([pointposX2, pointposY2])&amp;#10;#        pdeg2 = -degup2 + 90&amp;#10;&amp;#10;#keys1=event.getKeys()&amp;#10;&amp;#10;#if len(keys):&amp;#10;#    if 'left' in keys:&amp;#10;#        degup3 = (degup3 + 2)&amp;#10;#        posX3 = Eccentricityobj3 * cos((pi / 180) * (degup3))&amp;#10;#        posY3 = Eccentricityobj3 * sin((pi / 180) * (degup3))&amp;#10;#        Obj3LTM.setPos([posX3, posY3])&amp;#10;#        pointposX3 = Eccentricity3 * cos((pi / 180) * (degup3))&amp;#10;#        pointposY3 = Eccentricity3 * sin((pi / 180) * (degup3))&amp;#10;#        PointerLTM3.setPos([pointposX3, pointposY3])&amp;#10;#        pdeg3 = -degup3 + 90&amp;#10;&amp;#10;#    elif 'right' in keys:    &amp;#10;#        degup3 = (degup3 - 2)&amp;#10;#        posX3 = Eccentricityobj3 * cos((pi / 180) * (degup3))&amp;#10;#        posY3 = Eccentricityobj3 * sin((pi / 180) * (degup3))&amp;#10;#        Obj3LTM.setPos([posX3, posY3])&amp;#10;#        pointposX3 = Eccentricity3 * cos((pi / 180) * (degup3))&amp;#10;#        pointposY3 = Eccentricity3 * sin((pi / 180) * (degup3))&amp;#10;#        PointerLTM3.setPos([pointposX3, pointposY3])&amp;#10;#        pdeg3 = -degup3 + 90" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="var _pj;&amp;#10;function _pj_snippets(container) {&amp;#10;    function in_es6(left, right) {&amp;#10;        if (((right instanceof Array) || ((typeof right) === &quot;string&quot;))) {&amp;#10;            return (right.indexOf(left) &gt; (- 1));&amp;#10;        } else {&amp;#10;            if (((right instanceof Map) || (right instanceof Set) || (right instanceof WeakMap) || (right instanceof WeakSet))) {&amp;#10;                return right.has(left);&amp;#10;            } else {&amp;#10;                return (left in right);&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;    container[&quot;in_es6&quot;] = in_es6;&amp;#10;    return container;&amp;#10;}&amp;#10;_pj = {};&amp;#10;_pj_snippets(_pj);&amp;#10;if ((_pj.in_es6(&quot;3&quot;, FCKey1_Prac.keys) || _pj.in_es6(&quot;4&quot;, FCKey1_Prac.keys))) {&amp;#10;    continueRoutine = false;&amp;#10;} else {&amp;#10;    if ((_pj.in_es6(&quot;1&quot;, FCKey1_Prac.keys) || _pj.in_es6(&quot;2&quot;, FCKey1_Prac.keys))) {&amp;#10;        continueRoutine = true;&amp;#10;    }&amp;#10;}&amp;#10;keys1 = psychoJS.eventManager.getKeys();&amp;#10;if (keys1.length) {&amp;#10;    if (_pj.in_es6(&quot;left&quot;, keys1)) {&amp;#10;        degup2 = (degup2 + 2);&amp;#10;        posX2 = (Eccentricityobj2 * Math.cos(((Math.PI / 180) * degup2)));&amp;#10;        posY2 = (Eccentricityobj2 * Math.sin(((Math.PI / 180) * degup2)));&amp;#10;        Obj1LTM_prac.setPos([posX2, posY2]);&amp;#10;        pointposX2 = (Eccentricity2 * Math.cos(((Math.PI / 180) * degup2)));&amp;#10;        pointposY2 = (Eccentricity2 * Math.sin(((Math.PI / 180) * degup2)));&amp;#10;        PointerLTM1_prac.setPos([pointposX2, pointposY2]);&amp;#10;        pdeg2 = (degup2 + 90);&amp;#10;    } else {&amp;#10;        if (_pj.in_es6(&quot;right&quot;, keys1)) {&amp;#10;            degup2 = (degup2 - 2);&amp;#10;            posX2 = (Eccentricityobj2 * Math.cos(((Math.PI / 180) * degup2)));&amp;#10;            posY2 = (Eccentri